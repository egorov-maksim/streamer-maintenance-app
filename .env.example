# Server
PORT=3000
DB_FILE=./backend/streamer.db
# Optional; default 10mb. Bulk event import JSON is larger than the CSV file (~100kb Express default is too small).
# JSON_BODY_LIMIT=10mb

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000

# Authentication: USERNAME:PASSWORD_HASH:ROLE:VESSEL_TAG[:GLOBAL] per user, comma-separated
# PASSWORD_HASH: bcrypt hash (generate: node -e "const b=require('bcryptjs');console.log(b.hashSync('yourpassword',10))")
# Roles: grandsuperuser, superuser, admin, viewer
# VESSEL_TAG: short vessel code (e.g. TTN, RAM)
# GLOBAL (optional): "true" to grant access to all vessels
# Examples (password "changeme" for all three below):
AUTH_USERS=GrandRoot:$2b$10$JbMv1wT87STUFw9LyuwprO0V5DIFEsKrpMZnNAiP4L/D3NohTqEgS:grandsuperuser:ALL:true,TTNOBS:$2b$10$JbMv1wT87STUFw9LyuwprO0V5DIFEsKrpMZnNAiP4L/D3NohTqEgS:superuser:TTN,TTNView:$2b$10$JbMv1wT87STUFw9LyuwprO0V5DIFEsKrpMZnNAiP4L/D3NohTqEgS:viewer:TTN
